POST http://localhost:8082/workload
Content-Type: application/json

{
  "trainerUsername": "Mike.Brown",
  "trainerFirstName": "Mike",
  "trainerLastName": "Brown",
  "isActive": true,
  "trainingDate": "2026-03-15",
  "trainingDuration": 60,
  "actionType": "ADD"
}

