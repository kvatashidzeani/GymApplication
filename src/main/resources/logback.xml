<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- transactionId from MDC correlates all logs for one REST transaction -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [tx:%X{transactionId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.gymcrm" level="DEBUG"/>
    <logger name="com.gymcrm.logging.Transaction" level="INFO"/>
    <logger name="com.gymcrm.logging.Operation" level="INFO"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
